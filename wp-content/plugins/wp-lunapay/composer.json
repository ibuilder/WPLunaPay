{
    "name": "wplunapay/wp-lunapay",
    "description": "WooCommerce MoonPay Payment Gateway",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "WPLunaPay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test":       "phpunit",
        "test-cover": "phpunit --coverage-text"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
